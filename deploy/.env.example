# Presserl deployment settings. Copy to .env and fill in every value below.
# Only mandatory values are listed; everything else has a working default.

# Public DNS name of this installation, without scheme or path. The public base URL is
# https://<PRESSERL_HOSTNAME>; your reverse proxy routes it to the presserl service and the
# realm template's redirect URIs must use the same name (see INSTALL.md).
PRESSERL_HOSTNAME=

# Password of the PostgreSQL user "presserl". Used by both the postgres and presserl services.
PRESSERL_DB_PASSWORD=

# Issuer URL of the Keycloak realm imported from keycloak/presserl-realm.json,
# e.g. https://auth.example.org/realms/presserl. Browser and presserl container must both reach it.
PRESSERL_OIDC_ISSUER=

# Secret of the confidential client "presserl-backend" (Keycloak: Clients > presserl-backend >
# Credentials). Used to create the first publisher through the Keycloak Admin API.
PRESSERL_OIDC_BACKEND_SECRET=

# Client id of the public admin app client from the realm template.
PRESSERL_OIDC_ADMIN_CLIENT_ID=presserl-admin

# First publisher. Created in Keycloak (group "publisher") on first start if no publisher exists;
# an existing user with this name joins the group and keeps their password.
PRESSERL_PUBLISHER_USERNAME=
PRESSERL_PUBLISHER_PASSWORD=

# --- Optional examples (defaults apply when unset) ---------------------------------------------
# PRESSERL_IMAGE=gufalcon/presserl:latest
# PRESSERL_HTTP_PORT=8080
# PRESSERL_NEWSPAPER_NAME=My Newspaper
# PRESSERL_NEWSPAPER_SUBTITLE=
# PRESSERL_NEWSPAPER_VISIBILITY=public
