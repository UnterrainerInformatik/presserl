@startuml architecture
title Presserl – Architecture (docker compose)
skinparam shadowing false
skinparam defaultFontName Sans-Serif

actor "Reader" as reader
actor "Newsroom\n(publisher, chief,\nsection editor, reporter)" as newsroom
node "Browser" {
  component "Reader pages\n(HTML + CSS)" as html
  component "Administration app\n(Compose MP, Wasm)" as admin
}
node "Operator's infrastructure" {
  component "Reverse proxy\n(Traefik labels / Caddy)\nTLS termination" as proxy
  component "Keycloak (shared)\nrealm from presserl-realm.json\ngroups: publisher,\neditor-in-chief, reader" as kc
}
node "deploy/ (docker compose)" {
  component "presserl\nQuarkus REST (reactive)\nQute reader\nstatic admin bundle (/admin)\nHibernate Reactive + Panache\nquarkus-oidc" as srv
  folder "theme/\ncustom.css, fonts, logo" as theme
  database "PostgreSQL\n(volume presserl-db)" as db
  database "rustfs (S3-compatible)\n(volume presserl-media)\nno published port" as media
}

reader --> html
newsroom --> admin
html --> proxy : HTTPS
admin --> proxy : /api REST/JSON\n+ bearer JWT
proxy --> srv : HTTP + X-Forwarded-*
srv --> html : renders (Qute)
admin <.. srv : bundle from /admin
theme ..> srv : mounted, served at /theme/
html ..> kc : private newspaper:\nOIDC code flow (session cookie)
admin --> kc : OIDC login (PKCE)\nCSP connect-src: issuer origin
srv --> kc : service account\n(users, groups)
srv ..> kc : JWKS / token validation
srv --> db : reactive PG client\n(Flyway via JDBC at startup)
srv --> media : S3 API: re-encoded images\n(no metadata)
@enduml
