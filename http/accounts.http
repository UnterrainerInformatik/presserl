### Token for the publisher
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{username}}&password={{password}}

> {%
    client.global.set("accessToken", response.body.access_token);
%}

### Token for the editor-in-chief
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{chiefUsername}}&password={{chiefPassword}}

> {%
    client.global.set("chiefToken", response.body.access_token);
%}

### Token for a reader
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{readerUsername}}&password={{readerPassword}}

> {%
    client.global.set("readerToken", response.body.access_token);
%}

### List accounts as publisher
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}

> {%
    client.test("200 with all assignable roles and the dev realm users", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.assignableRoles) === '["PUBLISHER","EDITOR_IN_CHIEF","READER"]',
            "assignableRoles " + JSON.stringify(response.body.assignableRoles));
        const chief = response.body.accounts.find(a => a.username === "chief");
        client.assert(chief && JSON.stringify(chief.roles) === '["EDITOR_IN_CHIEF"]', "chief " + JSON.stringify(chief));
        client.assert(response.body.accounts.every(a => Array.isArray(a.sectionRoles)), "sectionRoles missing");
        client.assert(!response.body.accounts.some(a => a.username.startsWith("service-account-")), "service account listed");
    });
%}

### List accounts as editor-in-chief
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{chiefToken}}

> {%
    client.test("200 with editor-in-chief and reader assignable", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.assignableRoles) === '["EDITOR_IN_CHIEF","READER"]',
            "assignableRoles " + JSON.stringify(response.body.assignableRoles));
    });
%}

### Readers may not list accounts
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{readerToken}}

> {%
    client.test("403", () => client.assert(response.status === 403, "status " + response.status));
%}

### Username suggestion
GET {{baseUrl}}/api/accounts/username-suggestion?firstName=J%C3%BCrgen%20Maria
Authorization: Bearer {{accessToken}}

> {%
    client.test("juergen-maria", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.username === "juergen-maria", "username " + response.body.username);
    });
%}

### Username suggestion for a short first name is numbered
GET {{baseUrl}}/api/accounts/username-suggestion?firstName=Li
Authorization: Bearer {{accessToken}}

> {%
    client.test("li-1", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.username === "li-1", "username " + response.body.username);
    });
%}

### Suggestion for a free username based on "Http Test"
GET {{baseUrl}}/api/accounts/username-suggestion?firstName=Http%20Test
Authorization: Bearer {{accessToken}}

> {%
    client.test("200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("newUsername", response.body.username);
%}

### Create an editor-in-chief as publisher
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Http", "lastName": "Test", "username": "{{newUsername}}", "roles": ["EDITOR_IN_CHIEF"] }

> {%
    client.test("201 with location and a four-word password", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/api/accounts/" + response.body.account.id),
            "Location " + response.headers.valueOf("Location"));
        client.assert(JSON.stringify(response.body.account.roles) === '["EDITOR_IN_CHIEF"]', "roles");
        client.assert(JSON.stringify(response.body.account.sectionRoles) === '[]', "sectionRoles");
        client.assert(/^[a-z]{3,8}(-[a-z]{3,8}){3}$/.test(response.body.password), "password shape");
    });
    client.global.set("newPassword", response.body.password);
    client.global.set("newAccountId", response.body.account.id);
%}

### The new account can log in with the generated password
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{newUsername}}&password={{newPassword}}

> {%
    client.test("token issued", () => client.assert(response.status === 200, "status " + response.status));
%}

### The username is now taken
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Http", "username": "{{newUsername}}", "roles": ["READER"] }

> {%
    client.test("409 at username", () => {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(response.body.errors[0].field === "username", JSON.stringify(response.body));
    });
%}

### Editor-in-chief may not create a publisher
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{chiefToken}}
Content-Type: application/json

{ "firstName": "Boss", "username": "http-boss", "roles": ["PUBLISHER"] }

> {%
    client.test("403 at roles", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(response.body.errors[0].field === "roles", JSON.stringify(response.body));
    });
%}

### Invalid username and no roles
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Max", "username": "Max Mustermann", "roles": [] }

> {%
    client.test("400 listing username and roles", () => {
        client.assert(response.status === 400, "status " + response.status);
        const fields = response.body.errors.map(e => e.field);
        client.assert(JSON.stringify(fields) === '["username","roles"]', JSON.stringify(fields));
    });
%}

### Username too short
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Li", "username": "li", "roles": ["READER"] }

> {%
    client.test("400 at username", () => {
        client.assert(response.status === 400, "status " + response.status);
        const fields = response.body.errors.map(e => e.field);
        client.assert(JSON.stringify(fields) === '["username"]', JSON.stringify(response.body));
        client.assert(response.body.errors[0].message === "must be at least 3 characters", JSON.stringify(response.body));
    });
%}

### Neither roles nor section roles
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Nobody", "username": "http-nobody", "roles": [], "sectionRoles": [] }

> {%
    client.test("400 at roles", () => {
        client.assert(response.status === 400, "status " + response.status);
        const fields = response.body.errors.map(e => e.field);
        client.assert(JSON.stringify(fields) === '["roles"]', JSON.stringify(response.body));
    });
%}

### Unknown section
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "Ghost", "username": "http-ghost", "roles": [], "sectionRoles": [{ "sectionId": 999999, "role": "REPORTER" }] }

> {%
    client.test("400 at sectionRoles", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.errors[0].field === "sectionRoles", JSON.stringify(response.body));
    });
%}

### Allowed actions of the publisher on the new account
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}

> {%
    client.test("role edit, reset and lock offered, nothing on the own account", () => {
        const created = response.body.accounts.find(a => a.id === client.global.get("newAccountId"));
        client.assert(JSON.stringify(created.allowedActions) === '["EDIT_ROLES","RESET_PASSWORD","LOCK"]', JSON.stringify(created));
        const own = response.body.accounts.find(a => a.username === "publisher");
        client.assert(own && JSON.stringify(own.allowedActions) === '[]', JSON.stringify(own));
    });
%}

### Reset the password of the new account
POST {{baseUrl}}/api/accounts/{{newAccountId}}/password-reset
Authorization: Bearer {{accessToken}}

> {%
    const previousPassword = client.global.get("newPassword");
    client.test("200 with the account and a new four-word password", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.account.id === client.global.get("newAccountId"), JSON.stringify(response.body.account));
        client.assert(/^[a-z]{3,8}(-[a-z]{3,8}){3}$/.test(response.body.password), "password shape");
        client.assert(response.body.password !== previousPassword, "password unchanged");
    });
    client.global.set("oldPassword", previousPassword);
    client.global.set("newPassword", response.body.password);
%}

### The old password no longer works
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{newUsername}}&password={{oldPassword}}

> {%
    client.test("401", () => client.assert(response.status === 401, "status " + response.status));
%}

### The new password works
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{newUsername}}&password={{newPassword}}

> {%
    client.test("token issued", () => client.assert(response.status === 200, "status " + response.status));
%}

### Lock the new account
POST {{baseUrl}}/api/accounts/{{newAccountId}}/lock
Authorization: Bearer {{accessToken}}

> {%
    client.test("200, disabled, unlock offered", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.enabled === false, JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.allowedActions) === '["EDIT_ROLES","RESET_PASSWORD","UNLOCK"]', JSON.stringify(response.body));
    });
%}

### Lock again is idempotent
POST {{baseUrl}}/api/accounts/{{newAccountId}}/lock
Authorization: Bearer {{accessToken}}

> {%
    client.test("200, still disabled", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.enabled === false, JSON.stringify(response.body));
    });
%}

### A locked account cannot log in
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{newUsername}}&password={{newPassword}}

> {%
    client.test("refused", () => client.assert(response.status === 400, "status " + response.status));
%}

### Unlock the new account
POST {{baseUrl}}/api/accounts/{{newAccountId}}/unlock
Authorization: Bearer {{accessToken}}

> {%
    client.test("200, enabled, lock offered", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.enabled === true, JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.allowedActions) === '["EDIT_ROLES","RESET_PASSWORD","LOCK"]', JSON.stringify(response.body));
    });
%}

### The editor-in-chief may not lock
POST {{baseUrl}}/api/accounts/{{newAccountId}}/lock
Authorization: Bearer {{chiefToken}}

> {%
    client.test("403 with an error body", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(response.body.errors[0].field === null, JSON.stringify(response.body));
    });
%}

### Unknown account
POST {{baseUrl}}/api/accounts/00000000-0000-0000-0000-000000000000/password-reset
Authorization: Bearer {{accessToken}}

> {%
    client.test("404", () => client.assert(response.status === 404, "status " + response.status));
%}

### The editor-in-chief may not edit the roles of an editor-in-chief
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/roles
Authorization: Bearer {{chiefToken}}
Content-Type: application/json

{ "roles": ["READER"], "sectionRoles": [] }

> {%
    client.test("403 with an error body", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(response.body.errors[0].field === null, JSON.stringify(response.body));
    });
%}

### The publisher makes the new account a reader
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roles": ["READER"], "sectionRoles": [] }

> {%
    client.test("200 with the new roles", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.id === client.global.get("newAccountId"), JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.roles) === '["READER"]', JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.sectionRoles) === '[]', JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.allowedActions) === '["EDIT_ROLES","RESET_PASSWORD","LOCK"]',
            JSON.stringify(response.body));
    });
%}

### Saving the same roles again changes nothing
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roles": ["READER"], "sectionRoles": [] }

> {%
    client.test("200, roles unchanged", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.roles) === '["READER"]', JSON.stringify(response.body));
    });
%}

### No role left
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roles": [], "sectionRoles": [] }

> {%
    client.test("400 at roles", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(JSON.stringify(response.body.errors.map(e => e.field)) === '["roles"]', JSON.stringify(response.body));
    });
%}

### Section roles are required
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roles": ["READER"] }

> {%
    client.test("400 at sectionRoles", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(JSON.stringify(response.body.errors.map(e => e.field)) === '["sectionRoles"]', JSON.stringify(response.body));
    });
%}

### Trust: the publisher's trust scopes in the list
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{accessToken}}

> {%
    const chief = response.body.accounts.find(a => a.username === "chief");
    client.test("200; the publisher may trust chief at PUBLISHER", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.accounts.every(a => Array.isArray(a.trusts) && Array.isArray(a.trustScopes)),
            "trusts or trustScopes missing");
        client.assert(JSON.stringify(chief.trustScopes) === '[{"level":"PUBLISHER","sectionId":null}]',
            JSON.stringify(chief));
    });
    client.global.set("chiefId", chief.id);
%}

### Trust: the publisher trusts chief
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "sectionId": null, "trusted": true }

> {%
    client.test("200 with the trust entry", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.username === "chief", JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.trusts) === '[{"level":"PUBLISHER","sectionId":null}]',
            JSON.stringify(response.body));
        client.assert(JSON.stringify(response.body.trustScopes) === '[{"level":"PUBLISHER","sectionId":null}]',
            JSON.stringify(response.body));
    });
%}

### Trust: setting it again is idempotent
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "trusted": true }

> {%
    client.test("200, one entry", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.trusts) === '[{"level":"PUBLISHER","sectionId":null}]',
            JSON.stringify(response.body));
    });
%}

### Trust: the publisher clears it
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "sectionId": null, "trusted": false }

> {%
    client.test("200 without trust entries", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.trusts) === '[]', JSON.stringify(response.body));
    });
%}

### Trust: only at the own highest level
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "EDITOR_IN_CHIEF", "trusted": true }

> {%
    client.test("403 with an error body", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(response.body.errors[0].message === "you may not change trust of account 'chief' at EDITOR_IN_CHIEF",
            JSON.stringify(response.body));
    });
%}

### Trust: not on an account that writes nowhere
PUT {{baseUrl}}/api/accounts/{{newAccountId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "trusted": true }

> {%
    client.test("403 with an error body", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(response.body.errors[0].field === null, JSON.stringify(response.body));
    });
%}

### Trust: not on oneself
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{chiefToken}}
Content-Type: application/json

{ "level": "EDITOR_IN_CHIEF", "trusted": true }

> {%
    client.test("403", () => {
        client.assert(response.status === 403, "status " + response.status);
    });
%}

### Trust: readers have no account access
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{readerToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "trusted": true }

> {%
    client.test("403 with an empty body", () => {
        client.assert(response.status === 403, "status " + response.status);
        client.assert(!response.body, JSON.stringify(response.body));
    });
%}

### Trust: no section for a newspaper-wide level
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "sectionId": 1, "trusted": true }

> {%
    client.test("400 at sectionId", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(JSON.stringify(response.body.errors.map(e => e.field)) === '["sectionId"]', JSON.stringify(response.body));
    });
%}

### Trust: every violation is listed
PUT {{baseUrl}}/api/accounts/{{chiefId}}/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "SECTION_EDITOR", "trusted": "yes", "note": "x" }

> {%
    client.test("400 at note, sectionId and trusted", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(JSON.stringify(response.body.errors.map(e => e.field)) === '["note","sectionId","trusted"]',
            JSON.stringify(response.body));
    });
%}

### Trust: unknown account
PUT {{baseUrl}}/api/accounts/00000000-0000-0000-0000-000000000000/trust
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "level": "PUBLISHER", "trusted": true }

> {%
    client.test("404", () => {
        client.assert(response.status === 404, "status " + response.status);
    });
%}
