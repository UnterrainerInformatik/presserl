### Body image: create a draft with an image block between two paragraphs
POST {{baseUrl}}/api/articles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "sectionId": {{gardenId}}, "headline": "The race", "body": { "version": 1, "blocks": [
  { "type": "paragraph", "content": [ { "text": "We ran." } ] },
  { "type": "image", "mediaId": {{leadMediaId}}, "caption": "The finish line" },
  { "type": "image", "mediaId": {{leadMediaId}} },
  { "type": "paragraph", "content": [ { "text": "We won." } ] } ] } }

> {%
    client.test("201 with the body as sent", () => {
        client.assert(response.status === 201, "status " + response.status);
        const blocks = response.body.body.blocks;
        client.assert(blocks[1].type === "image" && blocks[1].mediaId === client.global.get("leadMediaId"), JSON.stringify(blocks));
        client.assert(blocks[1].caption === "The finish line", JSON.stringify(blocks[1]));
        client.assert(!("caption" in blocks[2]), JSON.stringify(blocks[2]));
    });
    client.global.set("bodyImageArticleId", response.body.id);
    client.global.set("bodyImageVersion", response.body.version);
%}

