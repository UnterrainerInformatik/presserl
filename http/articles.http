### Chain: the author reads the reviews, newest first
GET {{baseUrl}}/api/articles/{{chainId}}/reviews
Authorization: Bearer {{readerToken}}

> {%
    client.test("200 rejection by chief, then approval by nogroups", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(JSON.stringify(response.body.map(r => r.decision)) === '["REJECTED","APPROVED"]', JSON.stringify(response.body));
        client.assert(response.body[0].reviewer.username === "chief" && response.body[0].level === "EDITOR_IN_CHIEF", "rejection");
        client.assert(response.body[0].note.startsWith("Too short"), "note " + response.body[0].note);
        client.assert(response.body[1].reviewer.username === "nogroups" && response.body[1].note === null, "approval");
    });
%}

