### Chain: reporter writes an article to submit
POST {{baseUrl}}/api/articles
Authorization: Bearer {{readerToken}}
Content-Type: application/json

{ "sectionId": {{gardenId}}, "headline": "Harvest festival" }

> {%
    client.global.set("chainId", response.body.id);
    client.global.set("chainVersion", response.body.version);
%}

### Chain: reporter may not publish (a level applies)
POST {{baseUrl}}/api/articles/{{chainId}}/publish
Authorization: Bearer {{readerToken}}

> {%
    client.test("403", () => client.assert(response.status === 403, "status " + response.status));
%}

### Chain: reporter submits, it waits for the section editor
POST {{baseUrl}}/api/articles/{{chainId}}/submit
Authorization: Bearer {{readerToken}}

> {%
    const before = client.global.get("chainVersion");
    client.test("200 SUBMITTED waiting for SECTION_EDITOR", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "SUBMITTED", "status " + response.body.status);
        client.assert(response.body.pendingLevel === "SECTION_EDITOR", "pendingLevel " + response.body.pendingLevel);
        client.assert(response.body.version > before, "version " + response.body.version);
        client.assert(JSON.stringify(response.body.allowedActions) === '["WITHDRAW","DELETE"]',
            "allowedActions " + JSON.stringify(response.body.allowedActions));
    });
    client.global.set("chainVersion", response.body.version);
%}

### Chain: content is frozen while waiting
PUT {{baseUrl}}/api/articles/{{chainId}}
Authorization: Bearer {{readerToken}}
Content-Type: application/json

{ "version": {{chainVersion}}, "sectionId": {{gardenId}}, "headline": "Changed" }

> {%
    client.test("409", () => client.assert(response.status === 409, "status " + response.status));
%}

### Chain: waiting articles of the section editor's section
GET {{baseUrl}}/api/articles?pending=true
Authorization: Bearer {{nogroupsToken}}

> {%
    client.test("200 with the waiting article and its actions", () => {
        client.assert(response.status === 200, "status " + response.status);
        const entry = response.body.find(a => a.id === client.global.get("chainId"));
        client.assert(entry !== undefined, JSON.stringify(response.body.map(a => a.id)));
        client.assert(entry.pendingLevel === "SECTION_EDITOR", "pendingLevel " + entry.pendingLevel);
        client.assert(JSON.stringify(entry.allowedActions) === '["APPROVE","REJECT"]', JSON.stringify(entry.allowedActions));
        client.assert(response.body.every(a => a.pendingLevel !== null), "only pending articles");
    });
%}

### Chain: the article awaits the section editor
GET {{baseUrl}}/api/articles?awaitingMe=true
Authorization: Bearer {{nogroupsToken}}

> {%
    client.test("200 with the waiting article, every entry approvable", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(a => a.id === client.global.get("chainId")), JSON.stringify(response.body.map(a => a.id)));
        client.assert(response.body.every(a => a.allowedActions.includes("APPROVE")), "only approvable articles");
    });
%}

