### Usage of an unused image
GET {{baseUrl}}/api/media/{{photoId}}/usage
Authorization: Bearer {{accessToken}}

> {%
    client.test("200, the publisher may edit, no articles", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.mayEdit === true, "mayEdit " + response.body.mayEdit);
        client.assert(Array.isArray(response.body.articles), JSON.stringify(response.body));
    });
%}

