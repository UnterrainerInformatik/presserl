### Crop and pixelate a face
POST {{baseUrl}}/api/media/{{photoId}}/edit
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "version": 0,
  "crop": { "x": 40, "y": 30, "width": 480, "height": 320 },
  "pixelate": [ { "cx": 300, "cy": 200, "rx": 60, "ry": 80 } ] }

> {%
    client.test("200 with the edited media under the same id", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.id === client.global.get("photoId") * 1, "id " + response.body.id);
        client.assert(response.body.version === 1, "version " + response.body.version);
        client.assert(response.body.width === 480 && response.body.height === 320,
            "size " + response.body.width + " x " + response.body.height);
        client.assert(response.body.renditions.thumbnail.width === 480, "thumbnail " + JSON.stringify(response.body.renditions));
    });
%}

### The same edit again, based on the old version
POST {{baseUrl}}/api/media/{{photoId}}/edit
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "version": 0, "pixelate": [ { "cx": 100, "cy": 100, "rx": 20, "ry": 20 } ] }

> {%
    client.test("409 naming version", () => {
        client.assert(response.status === 409, "status " + response.status);
        client.assert(response.body.errors[0].field === "version", JSON.stringify(response.body));
        client.assert(response.body.errors[0].message === "media " + client.global.get("photoId") + " was changed meanwhile",
            response.body.errors[0].message);
    });
%}

### Revalidate with the old ETag: the edited image comes back
GET {{baseUrl}}/api/media/{{photoId}}/renditions/web
Authorization: Bearer {{accessToken}}
If-None-Match: "{{photoId}}-0"

> {%
    client.test("200 with the new ETag", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("ETag") === '"' + client.global.get("photoId") + '-1"',
            "etag " + response.headers.valueOf("ETag"));
    });
%}

