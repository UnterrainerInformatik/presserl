### Revalidate the stored image: unchanged → 304
GET {{baseUrl}}/api/media/{{photoId}}/content
Authorization: Bearer {{accessToken}}
If-None-Match: "{{photoId}}-0"

> {%
    client.test("304 without a body", () => {
        client.assert(response.status === 304, "status " + response.status);
        client.assert(response.headers.valueOf("ETag") === '"' + client.global.get("photoId") + '-0"',
            "etag " + response.headers.valueOf("ETag"));
    });
%}

### List the media, newest first, two per page
GET {{baseUrl}}/api/media?limit=2
Authorization: Bearer {{accessToken}}

> {%
    client.test("200 with a page of media and usage counts", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.items.length <= 2, "items " + response.body.items.length);
        const ids = response.body.items.map(item => item.id);
        client.assert(ids.every((id, i) => i === 0 || ids[i - 1] > id), "newest first " + ids);
        client.assert(response.body.items.every(item => typeof item.usageCount === "number" && typeof item.version === "number"),
            "usageCount and version " + JSON.stringify(response.body.items));
        client.assert(response.body.next === null || response.body.next === ids[ids.length - 1], "next " + response.body.next);
    });
%}

