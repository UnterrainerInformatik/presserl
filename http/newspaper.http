### Effective newspaper settings (public)
GET {{baseUrl}}/api/newspaper
Accept: application/json

> {%
    client.test("200 with name, visibility and settings", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(typeof response.body.name === "string", "name");
        client.assert(["public", "private"].includes(response.body.visibility), "visibility");
        client.assert(response.body.settings["editor.level"] !== undefined, "settings");
        client.assert(response.headers.valueOf("Content-Security-Policy").startsWith("default-src 'self'"), "CSP");
    });
%}
