### Token for the publisher
POST {{issuer}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=presserl-http&username={{username}}&password={{password}}

> {%
    client.global.set("accessToken", response.body.access_token);
%}

### Create an article with every block type and markup in the headline
POST {{baseUrl}}/api/articles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "kicker": "Garden",
  "headline": "<b>Pumpkin</b> record",
  "lead": "The biggest one yet.",
  "body": {"version": 1, "blocks": [
    {"type": "paragraph", "content": [{"text": "It started "}, {"text": "in May", "bold": true}, {"text": ".\nThen it grew."}]},
    {"type": "subhead", "text": "Watering"},
    {"type": "quote", "content": [{"text": "Every day!"}]},
    {"type": "list", "items": [[{"text": "Water"}], [{"text": "Sun"}]]}]}
}

> {%
    client.global.set("readerArticleId", response.body.id);
%}

### The draft is not on the reader yet
GET {{baseUrl}}/articles/{{readerArticleId}}

> {%
    client.test("404 page for a draft", () => {
        client.assert(response.status === 404, "status " + response.status);
        client.assert(!response.body.includes("Pumpkin"), "draft content leaked");
    });
%}

### Publish it
POST {{baseUrl}}/api/articles/{{readerArticleId}}/publish
Authorization: Bearer {{accessToken}}

> {%
    client.test("published", () => client.assert(response.body.status === "PUBLISHED", "status " + response.body.status));
    client.global.set("readerVersion", response.body.version);
%}

### Change it without publishing
PUT {{baseUrl}}/api/articles/{{readerArticleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "version": {{readerVersion}}, "headline": "Unpublished headline" }

> {%
    client.test("saved", () => client.assert(response.status === 200, "status " + response.status));
%}

### Front page (German by default)
GET {{baseUrl}}/

> {%
    client.test("front page lists the live revision", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("Vary") === "Accept-Language, Cookie", "Vary");
        client.assert(response.body.includes('<html lang="de" data-text-size="m">'), "lang");
        client.assert(response.body.includes('href="/articles/' + client.global.get("readerArticleId") + '"'), "link");
        client.assert(response.body.includes("&lt;b&gt;Pumpkin&lt;/b&gt; record"), "escaped headline");
        client.assert(!response.body.includes("Unpublished headline"), "unpublished changes leaked");
    });
%}

### Article page
GET {{baseUrl}}/articles/{{readerArticleId}}

> {%
    client.test("article page renders the live revision", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.includes('data-view="article"'), "view");
        client.assert(response.body.includes("<p>It started <strong>in May</strong>.<br>Then it grew.</p>"), "paragraph");
        client.assert(response.body.includes("<h2>Watering</h2>"), "subhead");
        client.assert(response.body.includes("<blockquote><p>Every day!</p></blockquote>"), "quote");
        client.assert(response.body.includes("Von publisher"), "byline");
        client.assert(!response.body.includes("Unpublished headline"), "unpublished changes leaked");
        client.assert(!response.body.includes("<script"), "script");
    });
%}

### Article page in English
GET {{baseUrl}}/articles/{{readerArticleId}}
Accept-Language: en-GB,en;q=0.9

> {%
    client.test("English chrome", () => {
        client.assert(response.body.includes('<html lang="en" data-text-size="m">'), "lang");
        client.assert(response.body.includes("By publisher"), "byline");
        client.assert(response.body.includes("Published on "), "date wording");
    });
%}

### Malformed id
GET {{baseUrl}}/articles/abc

> {%
    client.test("404 page", () => {
        client.assert(response.status === 404, "status " + response.status);
        client.assert(response.body.includes('<a href="/">Zur Titelseite</a>'), "link to front page");
    });
%}

### Print view of the article
GET {{baseUrl}}/print/article/{{readerArticleId}}

> {%
    client.test("print view of the live revision with the print script", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("Content-Security-Policy").startsWith("default-src 'self';"), "csp");
        client.assert(response.body.includes('<main data-view="print-article">'), "view");
        client.assert(response.body.includes('<h1 class="headline">&lt;b&gt;Pumpkin&lt;/b&gt; record</h1>'), "headline");
        client.assert(response.body.includes("<h2>Watering</h2>"), "body");
        client.assert(response.body.includes('<script src="/reader/print.js" defer></script>'), "script");
        client.assert(response.body.includes('<button type="button" data-print hidden>Drucken</button>'), "button");
        client.assert(!response.body.includes("Unpublished headline"), "unpublished changes leaked");
    });
%}

### The article page links its print view
GET {{baseUrl}}/articles/{{readerArticleId}}

> {%
    client.test("print link", () => client.assert(
        response.body.includes('<a href="/print/article/' + client.global.get("readerArticleId") + '">Drucken</a>'), "print link"));
%}

### Print view with a malformed id
GET {{baseUrl}}/print/article/abc

> {%
    client.test("404 page", () => client.assert(response.status === 404, "status " + response.status));
%}

### Print script and print rules
GET {{baseUrl}}/reader/print.js

> {%
    client.test("same-origin script", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.includes("window.print()"), "print");
    });
%}

### Stylesheet with A4 pages and page numbers
GET {{baseUrl}}/reader/reader.css

> {%
    client.test("@page A4 with counter", () => {
        client.assert(response.body.includes("size: A4 portrait"), "A4");
        client.assert(response.body.includes("content: counter(page)"), "counter");
    });
%}

### Clean up: take the article offline, it disappears from the reader
POST {{baseUrl}}/api/articles/{{readerArticleId}}/offline
Authorization: Bearer {{accessToken}}

> {%
    client.test("offline", () => client.assert(response.body.status === "OFFLINE", "status " + response.body.status));
%}

### Offline article is gone
GET {{baseUrl}}/articles/{{readerArticleId}}

> {%
    client.test("404 after taking offline", () => client.assert(response.status === 404, "status " + response.status));
%}

### Lead image: upload a photo
POST {{baseUrl}}/api/media
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=PresserlBoundary

--PresserlBoundary
Content-Disposition: form-data; name="file"; filename="photo-gps.jpg"
Content-Type: image/jpeg

< ./media/photo-gps.jpg
--PresserlBoundary--

> {%
    client.global.set("readerMediaId", response.body.id);
%}

### Lead image: a draft carries it
POST {{baseUrl}}/api/articles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "headline": "Minka is back", "leadImage": { "mediaId": {{readerMediaId}}, "caption": "Our cat <b>Minka</b>" } }

> {%
    client.global.set("imageArticleId", response.body.id);
%}

### Lead image: only in a draft, readers get an empty 404
GET {{baseUrl}}/media/{{readerMediaId}}/web

> {%
    client.test("404 without body", () => {
        client.assert(response.status === 404, "status " + response.status);
        client.assert(!response.body, "body " + response.body);
    });
%}

### Lead image: publish the article
POST {{baseUrl}}/api/articles/{{imageArticleId}}/publish
Authorization: Bearer {{accessToken}}

> {%
    client.test("published", () => client.assert(response.body.status === "PUBLISHED", "status " + response.body.status));
%}

### Lead image: the web rendition is served to readers
GET {{baseUrl}}/media/{{readerMediaId}}/web

> {%
    client.test("200 JPEG, public for an hour", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("Content-Type") === "image/jpeg", "type " + response.headers.valueOf("Content-Type"));
        client.assert(response.headers.valueOf("X-Content-Type-Options") === "nosniff", "nosniff");
        client.assert(response.headers.valueOf("Cache-Control") === "public, max-age=3600",
            "cache " + response.headers.valueOf("Cache-Control"));
    });
%}

### Lead image: the stored image is never served
GET {{baseUrl}}/media/{{readerMediaId}}/original

> {%
    client.test("404", () => client.assert(response.status === 404, "status " + response.status));
%}

### Lead image: the article page shows the figure with the escaped caption
GET {{baseUrl}}/articles/{{imageArticleId}}

> {%
    client.test("figure with web rendition and caption", () => {
        const id = client.global.get("readerMediaId");
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.includes('<figure class="lead-image">'), "figure");
        client.assert(response.body.includes('src="/media/' + id + '/web"'), "src");
        client.assert(response.body.includes('<figcaption class="lead-image__caption">Our cat &lt;b&gt;Minka&lt;/b&gt;</figcaption>'),
            "caption");
    });
%}

### Lead image: the print view uses the print rendition
GET {{baseUrl}}/print/article/{{imageArticleId}}

> {%
    client.test("print rendition", () => {
        const id = client.global.get("readerMediaId");
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.includes('src="/media/' + id + '/print"'), "src");
        client.assert(!response.body.includes("srcset"), "srcset");
    });
%}

### Lead image: the print rendition is served to readers
GET {{baseUrl}}/media/{{readerMediaId}}/print

> {%
    client.test("200 JPEG", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("Content-Type") === "image/jpeg", "type " + response.headers.valueOf("Content-Type"));
    });
%}

### Lead image: take it offline, the image is gone for readers
POST {{baseUrl}}/api/articles/{{imageArticleId}}/offline
Authorization: Bearer {{accessToken}}

### Lead image: offline article's image
GET {{baseUrl}}/media/{{readerMediaId}}/web

> {%
    client.test("404", () => client.assert(response.status === 404, "status " + response.status));
%}

### Text-size switch: choose XL and return to the front page
# @no-redirect
# @no-cookie-jar
POST {{baseUrl}}/text-size
Content-Type: application/x-www-form-urlencoded

size=xl&next=/

> {%
    client.test("303 home with the cookie", () => {
        client.assert(response.status === 303, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/"), "location " + response.headers.valueOf("Location"));
        const cookie = response.headers.valueOf("Set-Cookie");
        client.assert(cookie.includes("presserl_text_size=xl") && cookie.includes("HttpOnly")
            && cookie.toLowerCase().includes("samesite=lax"), "cookie " + cookie);
    });
%}

### The reader's own size wins
# @no-cookie-jar
GET {{baseUrl}}/
Cookie: presserl_text_size=xl

> {%
    client.test("data-text-size xl, XL pressed", () => {
        client.assert(response.body.includes('data-text-size="xl"'), "no data-text-size xl");
        client.assert(response.body.includes('value="xl" aria-pressed="true"'), "XL not pressed");
    });
%}

### Open redirect is refused
# @no-redirect
# @no-cookie-jar
POST {{baseUrl}}/text-size
Content-Type: application/x-www-form-urlencoded

size=l&next=https://evil.example/

> {%
    client.test("303 to / instead", () => {
        client.assert(response.status === 303, "status " + response.status);
        client.assert(!response.headers.valueOf("Location").includes("evil"), "location " + response.headers.valueOf("Location"));
    });
%}

### Unknown size sets no cookie
# @no-redirect
# @no-cookie-jar
POST {{baseUrl}}/text-size
Content-Type: application/x-www-form-urlencoded

size=huge&next=/

> {%
    client.test("303 without cookie", () => {
        client.assert(response.status === 303, "status " + response.status);
        client.assert(!response.headers.valueOf("Set-Cookie"), "cookie " + response.headers.valueOf("Set-Cookie"));
    });
%}

### QR code entry of the account slip: username as login hint, fragment dropped
# @no-redirect
# @no-cookie-jar
GET {{baseUrl}}/qr?u=lena

> {%
    client.test("303 to the login with hint and empty fragment", () => {
        client.assert(response.status === 303, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/login?login_hint=lena#"), "location " + response.headers.valueOf("Location"));
        client.assert(response.headers.valueOf("Cache-Control") === "no-store", "cache " + response.headers.valueOf("Cache-Control"));
        client.assert(!response.headers.valueOf("Set-Cookie"), "cookie " + response.headers.valueOf("Set-Cookie"));
    });
%}

### QR code entry with an invalid username: plain login
# @no-redirect
# @no-cookie-jar
GET {{baseUrl}}/qr?u=Lena%20X

> {%
    client.test("303 to the login without hint", () => {
        client.assert(response.status === 303, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/login#"), "location " + response.headers.valueOf("Location"));
    });
%}

### Login forwards the hint to Keycloak
# @no-redirect
# @no-cookie-jar
GET {{baseUrl}}/login?login_hint=lena

> {%
    client.test("302 to the authorization endpoint with login_hint", () => {
        client.assert(response.status === 302, "status " + response.status);
        const location = response.headers.valueOf("Location");
        client.assert(location.includes("/protocol/openid-connect/auth") && location.includes("login_hint=lena"), "location " + location);
    });
%}

### Fork theme: needs quarkus:dev started with -Dpresserl.theme.dir=../deploy/theme
GET {{baseUrl}}/theme/custom.css

> {%
    client.test("custom.css served and revalidated", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.headers.valueOf("Content-Type").startsWith("text/css"), "type " + response.headers.valueOf("Content-Type"));
        client.assert(response.headers.valueOf("Cache-Control") === "no-cache", "cache " + response.headers.valueOf("Cache-Control"));
    });
%}

### The front page links custom.css after the default theme
# @no-cookie-jar
GET {{baseUrl}}/

> {%
    client.test("custom.css linked last", () => {
        const body = response.body;
        const own = body.indexOf('href="/theme/custom.css"');
        client.assert(own > body.indexOf('href="/reader/reader.css"') && own > 0, "custom.css not linked after reader.css");
    });
%}

